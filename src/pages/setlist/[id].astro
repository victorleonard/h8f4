---
import type { Robots } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Brand from '../../components/Brand.astro';
import Logo from '../../components/Logo.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { withBase } from '../../utils/path';
import { brandFull, brandSeo } from '../../data/brand';
import '../../styles/global.css';

export const prerender = false;

export const robots: Robots = {
  index: false,
  follow: false,
};

const setlistId = Astro.params.id ?? '';
const pageTitle = 'Setlist — H8F4';
const pageDescription = 'Détail et édition d’une setlist de concert.';
---

<Layout title={pageTitle} description={pageDescription} minimal>
  <div class="propal-page setlist-page setlist-page--detail">
    <header class="propal-page__bar">
      <div class="container-content flex items-center justify-between gap-3">
        <a href={withBase('/')} class="cursor-pointer shrink-0" aria-label={`${brandSeo} — Accueil`}>
          <Brand variant="header" />
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          <ThemeToggle />
          <a
            href={withBase('/')}
            class="propal-page__back inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-lg px-2 text-sm text-text-muted transition-colors duration-200 hover:text-accent sm:min-h-0 sm:min-w-0 sm:px-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            <span class="hidden sm:inline">Retour au site</span>
          </a>
        </div>
      </div>
    </header>

    <main class="propal-page__main">
      <section class="setlist-detail-section pb-6 sm:pb-8">
        <div
          class="container-content max-w-3xl"
          data-setlist-app
          data-setlist-page="detail"
          data-setlist-id={setlistId}
        >
          <div class="setlist-detail-toolbar" data-setlist-toolbar>
            <div class="setlist-detail-toolbar__top setlist-page__inset">
              <a
                href={withBase('/setlist/')}
                class="setlist-back-btn setlist-detail-toolbar__back"
                data-setlist-back-list
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                <span>Setlists</span>
              </a>
              <details class="setlist-more-menu">
                <summary class="setlist-icon-btn setlist-more-menu__trigger" aria-label="Plus d’actions">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                </summary>
                <div class="setlist-more-menu__panel" role="menu">
                  <button type="button" class="setlist-more-menu__item" data-setlist-print role="menuitem">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3h12v6"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
                    Imprimer
                  </button>
                  <button type="button" class="setlist-more-menu__item" data-setlist-fullscreen-open role="menuitem">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="m21 3-7 7"/><path d="M9 21H3v-6"/><path d="m3 21 7-7"/></svg>
                    Plein écran
                  </button>
                  <button type="button" class="setlist-more-menu__item setlist-more-menu__item--danger" data-setlist-delete role="menuitem">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    Supprimer la setlist
                  </button>
                </div>
              </details>
            </div>

            <div class="setlist-detail-toolbar__head setlist-page__inset" data-setlist-title-row>
              <h1
                class="setlist-detail-toolbar__title"
                data-setlist-form-title
                data-setlist-name-display
              >
                Setlist
              </h1>
              <button
                type="button"
                class="setlist-icon-btn shrink-0"
                data-setlist-meta-edit
                aria-label="Renommer la setlist"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
              </button>
            </div>

            <div class="setlist-page__inset hidden space-y-3 pb-2" data-setlist-meta-fields>
              <div>
                <label for="setlist-name" class="mb-1.5 block text-sm font-medium">Nom de la setlist *</label>
                <input
                  class="input-field"
                  type="text"
                  id="setlist-name"
                  required
                  minlength="2"
                  maxlength="120"
                  placeholder="ex. Festival d'été"
                  data-setlist-name
                />
              </div>
              <button type="button" class="btn-secondary min-h-10 px-3 py-2 text-sm" data-setlist-meta-done>
                Terminer
              </button>
            </div>

            <div class="setlist-detail-toolbar__stats setlist-page__inset" data-setlist-estimate>
              <div class="setlist-duration-stats">
                <span class="setlist-duration-stats__line">Jeu&nbsp;: <strong class="text-text">0 min</strong></span>
              </div>
            </div>
          </div>

          <p class="mt-3 hidden text-sm text-success setlist-page__inset" data-setlist-status role="status" aria-live="polite"></p>
          <p class="mt-3 hidden text-sm text-error setlist-page__inset" data-setlist-error role="alert" aria-live="assertive"></p>

          <form id="setlist-detail-form" class="setlist-detail-form" data-setlist-form data-setlist-content>
            <input type="hidden" data-setlist-edit-id value={setlistId} />
            <div class="setlist-page__inset space-y-2" data-setlist-picked></div>
          </form>

          <div class="setlist-detail-actions" aria-label="Actions de la setlist">
            <div class="setlist-detail-actions__inner setlist-page__inset">
              <button
                type="button"
                class="btn-secondary setlist-detail-actions__add"
                data-setlist-add-open
                aria-haspopup="dialog"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                Ajouter
              </button>
              <button
                type="submit"
                form="setlist-detail-form"
                class="btn-primary setlist-detail-actions__save"
                data-setlist-submit
                disabled
              >
                Enregistrer
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <div class="setlist-add-modal" data-setlist-add-modal hidden>
    <button
      type="button"
      class="setlist-add-modal__backdrop"
      data-setlist-add-close
      aria-label="Fermer"
    ></button>
    <div
      class="setlist-add-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="setlist-add-modal-title"
      data-setlist-add-panel
    >
      <div class="setlist-add-modal__header">
        <h2 id="setlist-add-modal-title" class="setlist-add-modal__title">Ajouter</h2>
        <button
          type="button"
          class="setlist-icon-btn"
          data-setlist-add-close
          aria-label="Fermer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="setlist-add-modal__body space-y-4">
        <div>
          <label for="setlist-add-song" class="mb-1.5 block text-sm font-medium">Ajouter un titre</label>
          <select class="input-field cursor-pointer" id="setlist-add-song" data-setlist-add-song>
            <option value="">Choisir un titre…</option>
          </select>
          <p
            class="mt-2 hidden text-sm text-success"
            data-setlist-add-feedback
            role="status"
            aria-live="polite"
          ></p>
        </div>
        <button
          type="button"
          class="btn-secondary min-h-11 w-full px-4 py-2.5 text-sm"
          data-setlist-add-pause
        >
          Ajouter une pause
        </button>
        <button
          type="button"
          class="btn-secondary min-h-11 w-full px-4 py-2.5 text-sm"
          data-setlist-add-all
        >
          Ajouter tous les titres disponibles
        </button>
      </div>
    </div>
  </div>

  <div
    class="setlist-fullscreen"
    data-setlist-fullscreen
    role="dialog"
    aria-modal="true"
    aria-labelledby="setlist-fullscreen-title"
    hidden
  >
    <div class="setlist-fullscreen__toolbar">
      <button
        type="button"
        class="setlist-fullscreen__action"
        data-setlist-fullscreen-print
        aria-label="Imprimer la setlist"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3h12v6"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
        <span>Imprimer</span>
      </button>
      <button
        type="button"
        class="setlist-fullscreen__action"
        data-setlist-fullscreen-close
        aria-label="Fermer le plein écran"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        <span>Fermer</span>
      </button>
    </div>

    <div class="setlist-fullscreen__sheet">
      <div class="setlist-fullscreen__print-root" data-setlist-print-root>
        <p class="setlist-fullscreen__estimate" data-setlist-fullscreen-estimate></p>
        <div class="setlist-fullscreen__brand">
          <Logo class="text-3xl sm:text-4xl" />
          <p class="setlist-fullscreen__brand-full">{brandFull}</p>
        </div>
        <h2 id="setlist-fullscreen-title" class="setlist-fullscreen__title" data-setlist-fullscreen-title></h2>
        <ol class="setlist-fullscreen__list" data-setlist-fullscreen-list></ol>
      </div>
    </div>
  </div>

  <script src="../../scripts/setlist.ts"></script>
</Layout>
