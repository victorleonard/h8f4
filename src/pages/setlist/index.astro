---
import type { Robots } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Brand from '../../components/Brand.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { withBase } from '../../utils/path';
import { brandSeo } from '../../data/brand';
import '../../styles/global.css';

export const robots: Robots = {
  index: false,
  follow: false,
};

const pageTitle = 'Répertoire & setlists — H8F4';
const pageDescription =
  'Espace interne pour gérer les titres du répertoire et composer les setlists de concert.';
---

<Layout title={pageTitle} description={pageDescription} minimal>
  <div class="propal-page setlist-page">
    <header class="propal-page__bar">
      <div class="container-content flex items-center justify-between gap-3">
        <a href={withBase('/')} class="cursor-pointer shrink-0" aria-label={`${brandSeo} — Accueil`}>
          <Brand variant="header" />
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          <ThemeToggle />
          <a
            href={withBase('/')}
            class="propal-page__back inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-lg px-2 text-sm text-text-muted transition-colors duration-200 hover:text-accent sm:min-h-0 sm:min-w-0 sm:px-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            <span class="hidden sm:inline">Retour au site</span>
          </a>
        </div>
      </div>
    </header>

    <main class="propal-page__main">
      <section class="pt-3 pb-6 sm:pt-4 sm:pb-8">
        <div class="container-content max-w-3xl" data-setlist-app data-setlist-page="list">
          <h1 class="section-title text-2xl sm:text-[28px] md:text-4xl">Répertoire &amp; setlists</h1>
          <div class="section-accent"></div>

          <p class="mt-4 hidden text-sm text-success" data-setlist-status role="status" aria-live="polite"></p>
          <p class="mt-4 hidden text-sm text-error" data-setlist-error role="alert" aria-live="assertive"></p>

          <div class="mt-4" data-setlist-content>
            <div class="propal-sticky-nav">
              <div class="propal-view-tabs" role="tablist" aria-label="Sections">
                <button
                  type="button"
                  class="propal-view-tab propal-view-tab--active"
                  role="tab"
                  aria-selected="true"
                  aria-controls="setlist-view-setlists"
                  id="setlist-tab-setlists"
                  data-setlist-view="setlists"
                >
                  Setlists
                  <span class="propal-view-tab__count" data-setlists-count>0</span>
                </button>
                <button
                  type="button"
                  class="propal-view-tab"
                  role="tab"
                  aria-selected="false"
                  aria-controls="setlist-view-songs"
                  id="setlist-tab-songs"
                  data-setlist-view="songs"
                >
                  Titres
                  <span class="propal-view-tab__count" data-songs-count>0</span>
                </button>
              </div>
            </div>

            <div
              id="setlist-view-setlists"
              role="tabpanel"
              aria-labelledby="setlist-tab-setlists"
              data-setlist-view-setlists
            >
              <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm text-text-muted" data-setlists-summary>Chargement…</p>
                <button type="button" class="btn-primary min-h-11 px-4 py-2.5 text-sm" data-setlist-create>
                  Ajouter une setlist
                </button>
              </div>
              <div class="mt-3 space-y-3" data-setlists-list>
                <p class="text-sm text-text-muted">Chargement des setlists…</p>
              </div>
            </div>

            <div
              id="setlist-view-songs"
              class="hidden"
              role="tabpanel"
              aria-labelledby="setlist-tab-songs"
              data-setlist-view-songs
            >
              <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm text-text-muted" data-songs-summary>Chargement…</p>
                <button type="button" class="btn-primary min-h-11 px-4 py-2.5 text-sm" data-song-create>
                  Ajouter un titre
                </button>
              </div>

              <div class="mt-6 hidden rounded-lg border border-border bg-surface p-4 sm:p-5" data-song-form-panel>
                <div class="flex items-center gap-3">
                  <button
                    type="button"
                    class="setlist-back-btn"
                    data-song-cancel
                    aria-label="Retour à la liste des titres"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    <span>Retour</span>
                  </button>
                </div>
                <h2 class="mt-4 font-display text-lg text-text" data-song-form-title>Ajouter un titre</h2>
                <p class="mt-1 text-sm text-text-muted">
                  Recherchez un morceau, puis complétez le tempo (BPM).
                </p>

                <div class="propal-proposal-search mt-5" data-setlist-song-search>
                  <label for="setlist-song-search" class="sr-only">Rechercher un titre ou un artiste</label>
                  <div class="propal-proposal-search__field">
                    <svg class="propal-proposal-search__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input
                      class="propal-proposal-search__input"
                      type="search"
                      id="setlist-song-search"
                      name="search"
                      autocomplete="off"
                      placeholder="Rechercher un titre ou un artiste…"
                      data-setlist-song-search-input
                    />
                  </div>
                  <div
                    class="propal-search-results hidden"
                    data-setlist-song-search-results
                    role="listbox"
                    aria-label="Résultats de recherche"
                  ></div>
                </div>

                <form class="mt-5 space-y-4" data-song-form>
                  <input type="hidden" data-song-edit-id />
                  <input type="hidden" data-song-artwork />
                  <div class="hidden items-center gap-3 rounded-lg border border-border bg-bg-alt p-3" data-song-preview>
                    <div data-song-preview-artwork></div>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold text-text" data-song-preview-title></p>
                      <p class="truncate text-xs text-text-muted" data-song-preview-meta></p>
                    </div>
                  </div>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                      <label for="setlist-song-title" class="mb-1.5 block text-sm font-medium">Titre *</label>
                      <input
                        class="input-field"
                        type="text"
                        id="setlist-song-title"
                        required
                        minlength="2"
                        maxlength="120"
                        placeholder="ex. Creep"
                        data-song-title
                      />
                    </div>
                    <div class="sm:col-span-2">
                      <label for="setlist-song-artist" class="mb-1.5 block text-sm font-medium">Artiste</label>
                      <input
                        class="input-field"
                        type="text"
                        id="setlist-song-artist"
                        maxlength="120"
                        placeholder="ex. Radiohead"
                        data-song-artist
                      />
                    </div>
                    <div>
                      <label for="setlist-song-minutes" class="mb-1.5 block text-sm font-medium">Durée *</label>
                      <div class="flex items-center gap-2">
                        <input
                          class="input-field"
                          type="number"
                          id="setlist-song-minutes"
                          min="0"
                          max="30"
                          required
                          placeholder="min"
                          data-song-minutes
                        />
                        <span class="text-sm text-text-muted">:</span>
                        <input
                          class="input-field"
                          type="number"
                          id="setlist-song-seconds"
                          min="0"
                          max="59"
                          required
                          placeholder="sec"
                          data-song-seconds
                        />
                      </div>
                    </div>
                    <div>
                      <label for="setlist-song-tempo" class="mb-1.5 block text-sm font-medium">Tempo (BPM) *</label>
                      <input
                        class="input-field"
                        type="number"
                        id="setlist-song-tempo"
                        min="40"
                        max="300"
                        required
                        placeholder="ex. 120"
                        data-song-tempo
                      />
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <button type="submit" class="btn-primary min-h-11 px-4 py-2.5 text-sm" data-song-submit>
                      Enregistrer
                    </button>
                  </div>
                </form>
              </div>

              <div class="mt-3 space-y-2" data-songs-list>
                <p class="text-sm text-text-muted">Chargement des titres…</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script src="../../scripts/setlist.ts"></script>
</Layout>
